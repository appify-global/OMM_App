# MATCH marketing website — copy to `apps/web/.env.local`
#
# This repo is the marketing site only. The Expo app and the mobile API moved to
# appify-global/OMM_Mobile and appify-global/OMM_BACKEND — their env lives there.
#
# Local: Next.js listens on port 3101 (`apps/web/package.json`).

# --- Clerk (required to boot) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
#
# Optional
# CLERK_WEBHOOK_SECRET=whsec_...
# BYPASS_CLERK_AUTH=false

# --- Postgres (waitlist signups + Clerk user sync) ---
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- The product ---
# Where "Dashboard", the post-signup redirect and the /welcome legal links point.
# Defaults to https://app.offmarketmatch.com.au (the OMM_Mobile deployment).
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:8081

# --- Waitlist mode (pre-launch) ---
# Set to "false" to re-enable Clerk sign-in / sign-up flows. Default: on.
# NEXT_PUBLIC_WAITLIST_MODE=true
#
# Resend — sends the thank-you email on waitlist signup.
# Without it: signups still save to Postgres, no email is sent (logged only).
# RESEND_API_KEY=re_...
# WAITLIST_FROM_EMAIL="MATCH <hello@your-verified-domain.com>"

# --- Home "Properties near …" geo (ipinfo.io — optional token for higher limits) ---
# IPINFO_TOKEN=
# GEO_DEV_CITY=Hawthorn
